<?xml version="1.0" encoding="utf-8"?>
<!-- Start: the accent itself, lit from above with a faint glow under it, so nothing else on the
     screen competes with it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
   android:color="@color/white">
  <item android:id="@android:id/mask" android:bottom="3dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/white"/>
      <corners android:radius="@dimen/card_corner"/>
    </shape>
  </item>
  <item>
    <selector>
      <item android:state_enabled="false">
        <layer-list>
        <item android:bottom="3dp">
          <shape android:shape="rectangle">
            <solid android:color="@color/button_disabled"/>
            <corners android:radius="@dimen/card_corner"/>
          </shape>
        </item>
        </layer-list>
      </item>
      <item>
        <layer-list>
          <item android:left="2dp" android:right="2dp" android:top="4dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/accent_glow_far"/>
              <corners android:radius="@dimen/card_corner"/>
            </shape>
          </item>
          <item android:left="1dp" android:right="1dp" android:top="2dp" android:bottom="1dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/accent_glow_mid"/>
              <corners android:radius="@dimen/card_corner"/>
            </shape>
          </item>
          <item android:top="1dp" android:bottom="2dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/accent_glow_near"/>
              <corners android:radius="@dimen/card_corner"/>
            </shape>
          </item>
          <item android:bottom="3dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/accent_lit_edge"/>
              <corners android:radius="@dimen/card_corner"/>
            </shape>
          </item>
          <item android:top="1dp" android:bottom="3dp">
            <shape android:shape="rectangle">
              <gradient
         android:angle="270"
         android:startColor="@color/accent_lit_top"
         android:endColor="@color/accent_lit_bottom"/>
              <corners android:radius="@dimen/card_corner"/>
            </shape>
          </item>
        </layer-list>
      </item>
    </selector>
  </item>
</ripple>
