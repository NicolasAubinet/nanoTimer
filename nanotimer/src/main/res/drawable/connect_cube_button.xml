<?xml version="1.0" encoding="utf-8"?>
<!-- Start's place while no cube is connected: a live outlined button that opens the connect
     dialog, so the screen's main control never reads as dead. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
   android:color="@color/lightblue">
  <item android:bottom="3dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/accent_wash_15"/>
      <stroke android:width="1.5dp" android:color="@color/lightblue"/>
      <corners android:radius="@dimen/card_corner"/>
    </shape>
  </item>
</ripple>
