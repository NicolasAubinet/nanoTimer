<?xml version="1.0" encoding="utf-8"?>
<!-- The purchase sheet's surface, lit teal at the top like the Plan tab's hero card. Rounded as the
     sheet's own window is, so it covers it exactly. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
   android:shape="rectangle">
  <gradient
     android:angle="270"
     android:startColor="#34444C"
     android:centerColor="@color/dialog_surface"
     android:centerY="0.4"
     android:endColor="@color/dialog_surface"/>
  <corners
     android:topLeftRadius="24dp"
     android:topRightRadius="24dp"/>
</shape>
