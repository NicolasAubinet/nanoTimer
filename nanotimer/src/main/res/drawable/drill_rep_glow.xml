<?xml version="1.0" encoding="utf-8"?>
<!-- The beat a solved case gets: a pool of light round the cube rather than a slab over it. White,
     because DrillRepFlourish tints it to the beat's colour and the tint keeps this alpha. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
   android:shape="rectangle">
  <gradient
     android:type="radial"
     android:gradientRadius="46%p"
     android:startColor="#FFFFFFFF"
     android:centerColor="#80FFFFFF"
     android:endColor="#00FFFFFF"/>
</shape>
