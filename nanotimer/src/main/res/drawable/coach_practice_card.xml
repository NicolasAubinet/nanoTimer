<?xml version="1.0" encoding="utf-8"?>
<!-- A standing practice set: outlined where a plan's card is filled, so it reads as always there
     rather than as one of this week's cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
   android:shape="rectangle">
  <stroke
     android:width="1.5dp"
     android:color="@color/hero_card"
     android:dashWidth="6dp"
     android:dashGap="4dp"/>
  <corners android:radius="14dp"/>
</shape>
