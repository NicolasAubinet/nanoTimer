<?xml version="1.0" encoding="utf-8"?>
<!-- The timer's statistics card, lit like the app's cards (analysis_card) on its own tone. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:left="2dp" android:right="2dp" android:top="4dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/card_shadow_far"/>
      <corners android:radius="8dp"/>
    </shape>
  </item>
  <item android:left="1dp" android:right="1dp" android:top="2dp" android:bottom="1dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/card_shadow_mid"/>
      <corners android:radius="8dp"/>
    </shape>
  </item>
  <item android:top="1dp" android:bottom="2dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/card_shadow_near"/>
      <corners android:radius="8dp"/>
    </shape>
  </item>
  <item android:bottom="3dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/timercard_lit_edge"/>
      <corners android:radius="8dp"/>
    </shape>
  </item>
  <item android:top="1dp" android:bottom="3dp">
    <shape android:shape="rectangle">
      <gradient
         android:angle="270"
         android:startColor="@color/timercard_lit_top"
         android:centerColor="@color/timercard_lit_mid"
         android:centerY="0.38"
         android:endColor="@color/timercard_lit_bottom"/>
      <corners android:radius="8dp"/>
    </shape>
  </item>
</layer-list>
