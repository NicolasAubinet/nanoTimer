<?xml version="1.0" encoding="utf-8"?>
<!-- The mark beside a base plan in the purchase sheet: a ring, filled for the one picked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_selected="true">
    <layer-list>
      <item>
        <shape android:shape="oval">
          <stroke android:width="2dp" android:color="@color/lightblue"/>
        </shape>
      </item>
      <item android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="5dp">
        <shape android:shape="oval">
          <solid android:color="@color/lightblue"/>
        </shape>
      </item>
    </layer-list>
  </item>
  <item>
    <shape android:shape="oval">
      <stroke android:width="2dp" android:color="@color/white_wash_50"/>
    </shape>
  </item>
</selector>
