<?xml version="1.0" encoding="utf-8"?>
<!-- A base plan in the purchase sheet, outlined when it is the one picked. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
   android:color="@color/lightblue">
  <item android:id="@android:id/mask" android:bottom="3dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/white"/>
      <corners android:radius="12dp"/>
    </shape>
  </item>
  <item>
    <selector>
      <item android:state_selected="true">
        <layer-list>
          <item android:left="2dp" android:right="2dp" android:top="4dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/card_shadow_far"/>
              <corners android:radius="12dp"/>
            </shape>
          </item>
          <item android:left="1dp" android:right="1dp" android:top="2dp" android:bottom="1dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/card_shadow_mid"/>
              <corners android:radius="12dp"/>
            </shape>
          </item>
          <item android:top="1dp" android:bottom="2dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/card_shadow_near"/>
              <corners android:radius="12dp"/>
            </shape>
          </item>
          <item android:bottom="3dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/card_lit_edge"/>
              <corners android:radius="12dp"/>
            </shape>
          </item>
          <item android:top="1dp" android:bottom="3dp">
            <shape android:shape="rectangle">
              <gradient
         android:angle="270"
         android:startColor="@color/card_lit_top"
         android:centerColor="@color/card_lit_mid"
         android:centerY="0.38"
         android:endColor="@color/card_lit_bottom"/>
            <stroke android:width="1.5dp" android:color="@color/lightblue"/>
              <corners android:radius="12dp"/>
            </shape>
          </item>
        </layer-list>
      </item>
      <item>
        <layer-list>
          <item android:left="2dp" android:right="2dp" android:top="4dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/card_shadow_far"/>
              <corners android:radius="12dp"/>
            </shape>
          </item>
          <item android:left="1dp" android:right="1dp" android:top="2dp" android:bottom="1dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/card_shadow_mid"/>
              <corners android:radius="12dp"/>
            </shape>
          </item>
          <item android:top="1dp" android:bottom="2dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/card_shadow_near"/>
              <corners android:radius="12dp"/>
            </shape>
          </item>
          <item android:bottom="3dp">
            <shape android:shape="rectangle">
              <solid android:color="@color/card_lit_edge"/>
              <corners android:radius="12dp"/>
            </shape>
          </item>
          <item android:top="1dp" android:bottom="3dp">
            <shape android:shape="rectangle">
              <gradient
         android:angle="270"
         android:startColor="@color/card_lit_top"
         android:centerColor="@color/card_lit_mid"
         android:centerY="0.38"
         android:endColor="@color/card_lit_bottom"/>
              <corners android:radius="12dp"/>
            </shape>
          </item>
        </layer-list>
      </item>
    </selector>
  </item>
</ripple>
