<?xml version="1.0" encoding="utf-8"?>
<!-- Asked once, before any weekly plan: which solve type the plans are for, and what is sent for
     them without the solver asking. Agreeing to one is agreeing to the other, so it is one dialog. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:paddingLeft="20dp"
     android:paddingRight="20dp"
     android:paddingTop="20dp"
     android:paddingBottom="4dp">

    <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:fontFamily="@font/roboto_medium"
       android:text="@string/coach_opt_in_title"
       android:textColor="@color/white"
       android:textSize="19sp"/>

    <!-- Opens the choice only when more than one solve type can carry the plans. -->
    <LinearLayout
       android:id="@+id/llCoachOptInType"
       android:layout_width="match_parent"
       android:layout_height="48dp"
       android:layout_marginTop="14dp"
       android:background="@drawable/coach_opt_in_field"
       android:gravity="center_vertical"
       android:orientation="horizontal"
       android:paddingLeft="12dp"
       android:paddingRight="12dp">

      <TextView
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:text="@string/coach_plans_for"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"/>

      <TextView
         android:id="@+id/tvCoachOptInType"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:fontFamily="@font/roboto_medium"
         android:textColor="@color/lightblue"
         android:textSize="15sp"/>
    </LinearLayout>

    <TextView
       android:id="@+id/tvCoachOptInBody"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="12dp"
       android:lineSpacingMultiplier="1.2"
       android:textColor="@color/white"
       android:textSize="14sp"/>

    <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:lineSpacingMultiplier="1.2"
       android:text="@string/coach_opt_in_figures"
       android:textColor="@color/white"
       android:textSize="14sp"/>

  </LinearLayout>

</ScrollView>
