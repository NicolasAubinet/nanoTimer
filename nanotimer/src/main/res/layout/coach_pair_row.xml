<?xml version="1.0" encoding="utf-8"?>
<!-- One F2L case a focus area names. An F2L case has no picture small enough for a row and its
     number is never shown, so the case itself is one tap away on the button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:gravity="center_vertical"
   android:minHeight="48dp"
   android:orientation="horizontal"
   android:paddingTop="@dimen/space_xs"
   android:paddingBottom="@dimen/space_xs">

  <LinearLayout
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:orientation="vertical">

    <TextView
       android:id="@+id/tvCoachCaseName"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:ellipsize="end"
       android:fontFamily="@font/roboto_medium"
       android:maxLines="1"
       android:textColor="@color/white"
       android:textSize="15sp"/>

    <TextView
       android:id="@+id/tvCoachCaseFigures"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="2dp"
       android:fontFeatureSettings="tnum"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"/>

    <TextView
       android:id="@+id/tvCoachCaseCost"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:fontFeatureSettings="tnum"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"/>
  </LinearLayout>

  <androidx.appcompat.widget.AppCompatButton
     android:id="@+id/buCoachPairCase"
     android:layout_width="wrap_content"
     android:layout_marginLeft="@dimen/space_m"
     android:paddingLeft="@dimen/space_m"
     android:paddingRight="@dimen/space_m"
     android:text="@string/coach_pair_show"
     style="@style/AccentGhostButton"/>

</LinearLayout>
