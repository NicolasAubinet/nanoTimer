<?xml version="1.0" encoding="utf-8"?>
<!-- One base plan in the purchase sheet: its name, what is paid first and what is paid after. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:layout_marginTop="8dp"
   android:background="@drawable/coach_purchase_plan"
   android:gravity="center_vertical"
   android:orientation="horizontal"
   android:paddingLeft="14dp"
   android:paddingRight="14dp"
   android:paddingTop="11dp"
   android:paddingBottom="11dp">

  <!-- Takes the row's selected state. -->
  <View
     android:layout_width="18dp"
     android:layout_height="18dp"
     android:layout_marginEnd="12dp"
     android:layout_marginRight="12dp"
     android:background="@drawable/coach_purchase_radio"
     android:duplicateParentState="true"/>

  <LinearLayout
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:orientation="vertical">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <TextView
         android:id="@+id/tvCoachPurchasePlanName"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:fontFamily="@font/roboto_medium"
         android:textColor="@color/white"
         android:textSize="15sp"/>

      <!-- How much less the offer's price is. Gone without one. -->
      <TextView
         android:id="@+id/tvCoachPurchasePlanTag"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginStart="8dp"
         android:layout_marginLeft="8dp"
         android:background="@drawable/row_chip_accent"
         android:fontFamily="@font/roboto_medium"
         android:paddingLeft="7dp"
         android:paddingRight="7dp"
         android:paddingTop="1dp"
         android:paddingBottom="1dp"
         android:textAllCaps="true"
         android:textColor="@color/lightblue"
         android:textSize="10.5sp"
         android:visibility="gone"/>
    </LinearLayout>

    <TextView
       android:id="@+id/tvCoachPurchasePlanFirst"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="2dp"
       android:textColor="@color/white"
       android:textSize="13sp"/>

    <TextView
       android:id="@+id/tvCoachPurchasePlanAfter"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"
       android:visibility="gone"/>
  </LinearLayout>

</LinearLayout>
