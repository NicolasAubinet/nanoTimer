<?xml version="1.0" encoding="utf-8"?>
<!-- One base plan in the purchase sheet, as a tile: its name, the first price big, what follows.
     The badge sits on the tile's top edge, so the tile starts below it. Both tiles take the row's
     height, so one without an offer's lines still matches the other. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:layout_width="0dp"
   android:layout_height="match_parent"
   android:layout_weight="1"
   android:clipChildren="false">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:layout_marginTop="10dp"
     android:background="@drawable/coach_purchase_plan"
     android:gravity="center_horizontal"
     android:orientation="vertical"
     android:paddingLeft="10dp"
     android:paddingRight="10dp"
     android:paddingTop="18dp"
     android:paddingBottom="15dp">

    <TextView
       android:id="@+id/tvCoachPurchasePlanName"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:fontFamily="@font/roboto_medium"
       android:letterSpacing="0.08"
       android:textAllCaps="true"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"/>

    <!-- Shrinks for a currency that writes long, rather than wrapping. -->
    <androidx.appcompat.widget.AppCompatTextView
       android:id="@+id/tvCoachPurchasePlanPrice"
       android:layout_width="match_parent"
       android:layout_height="40dp"
       android:layout_marginTop="2dp"
       android:fontFamily="@font/roboto"
       android:gravity="center"
       android:maxLines="1"
       android:textColor="@color/white"
       android:textStyle="bold"
       app:autoSizeMaxTextSize="30sp"
       app:autoSizeMinTextSize="16sp"
       app:autoSizeTextType="uniform"/>

    <TextView
       android:id="@+id/tvCoachPurchasePlanPer"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:gravity="center"
       android:textColor="@color/white"
       android:alpha="0.8"
       android:textSize="12.5sp"/>

    <!-- What the base plan costs once the offer is over. Gone without an offer. -->
    <TextView
       android:id="@+id/tvCoachPurchasePlanThen"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginTop="6dp"
       android:gravity="center"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"
       android:visibility="gone"/>
  </LinearLayout>

  <!-- How much less the offer's price is. Gone without one. -->
  <TextView
     android:id="@+id/tvCoachPurchasePlanTag"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_gravity="top|center_horizontal"
     android:background="@drawable/coach_purchase_badge"
     android:fontFamily="@font/roboto_medium"
     android:letterSpacing="0.04"
     android:paddingLeft="9dp"
     android:paddingRight="9dp"
     android:paddingTop="2dp"
     android:paddingBottom="2dp"
     android:textAllCaps="true"
     android:textColor="@color/coach_purchase_badge_text"
     android:textSize="11sp"
     android:visibility="gone"/>

</FrameLayout>
