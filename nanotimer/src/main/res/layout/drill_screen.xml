<?xml version="1.0" encoding="utf-8"?>
<!-- A drill: the case stands on the screen's cube and the smart cube is only the input, so the
     physical cube's own state never matters and there is nothing here to press to start or stop a
     rep. The cube reports both ends of one. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:fitsSystemWindows="true"
   android:layout_width="match_parent"
   android:layout_height="match_parent">

  <LinearLayout
     android:id="@+id/drillRunning"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="vertical"
     android:paddingLeft="12dp"
     android:paddingRight="12dp"
     android:paddingBottom="12dp">

    <!-- The cube stands on the bare mat, in the pool of shadow the timer's cube stands in, rather
         than in a well of its own: the screen's ground is the app's ground. -->
    <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="0dp"
       android:layout_weight="1">

      <!-- The beat a solved case gets: light round the cube, under it so the cube stays readable.
           Not clickable, and gone between reps. -->
      <View
         android:id="@+id/drillRepWash"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@drawable/drill_rep_glow"
         android:visibility="gone"/>

      <!-- ⚠️ INVISIBLE until the page has drawn, never GONE: a GONE WebView is not laid out, so
           the player would build into a 0x0 viewport and stay that size once shown. -->
      <WebView
         android:id="@+id/wvDrillCube"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@android:color/transparent"
         android:visibility="invisible"/>

      <ProgressBar
         android:id="@+id/pbDrillCube"
         style="?android:attr/progressBarStyle"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_gravity="center"/>

      <TextView
         android:id="@+id/tvDrillFallback"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_gravity="center"
         android:gravity="center"
         android:padding="16dp"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:visibility="gone"/>

      <include layout="@layout/drill_gyro_chip"/>
    </FrameLayout>

    <!-- Practice mode, or a learning drill's guided reps: the algorithm, in the scramble's face. -->
    <TextView
       android:id="@+id/tvDrillPracticeAlg"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="4dp"
       android:layout_marginBottom="6dp"
       android:gravity="center"
       android:lineSpacingMultiplier="1.1"
       android:textColor="@color/white"
       android:textSize="20sp"
       android:visibility="gone"/>

    <!-- ⚠️ The rep just FINISHED: its case, its time, and where the time went. All of it belongs to
         the case that is over, never to the one on screen, which is deliberately not named anywhere:
         naming it would hand the user the answer, and a recognition drill would be timing reading.

         The time is the screen's headline, as the timer's is. A minimum height holding all three
         lines, so the cube above does not jump as reps come and go; at a large system font it may
         still grow.

         This is also the only clock a drill shows. A running one would have to start somewhere,
         and a rep starts when its case is drawn, not when a frame is painted. -->
    <LinearLayout
       android:id="@+id/llDrillLastRep"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:minHeight="104dp"
       android:gravity="center"
       android:orientation="vertical">

      <TextView
         android:id="@+id/tvDrillLastRepName"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:letterSpacing="0.06"
         android:fontFamily="@font/roboto_medium"
         android:textSize="13sp"/>

      <LinearLayout
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:gravity="center_vertical"
         android:orientation="horizontal">

        <TextView
           android:id="@+id/tvDrillLastRep"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:includeFontPadding="false"
           android:textColor="@color/white"
           android:fontFamily="@font/roboto_bold"
           android:textSize="50sp"
           android:fontFeatureSettings="tnum"/>

        <!-- A coach drill's verdict on the rep, against its case's target. Gone on every other. -->
        <TextView
           android:id="@+id/tvDrillLastRepVerdict"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginLeft="10dp"
           android:background="@drawable/smart_cube_pill"
           android:paddingLeft="10dp"
           android:paddingRight="10dp"
           android:paddingTop="4dp"
           android:paddingBottom="4dp"
           android:singleLine="true"
           android:fontFamily="@font/roboto_medium"
           android:textColor="@color/on_accent"
           android:textSize="13sp"
           android:fontFeatureSettings="tnum"
           android:visibility="gone"/>
      </LinearLayout>

      <!-- Where the time went, drawn and then said: the looking as a wash of the family's colour,
           the turning at full strength, the same two inks as the case stats. -->
      <com.cube.nanotimer.util.view.DrillSplitBarView
         android:id="@+id/vDrillRepSplit"
         android:layout_width="220dp"
         android:layout_height="6dp"
         android:layout_marginTop="6dp"
         android:visibility="gone"/>

      <TextView
         android:id="@+id/tvDrillLastRepSplit"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="4dp"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"
         android:fontFeatureSettings="tnum"/>
    </LinearLayout>

    <!-- A coach drill's offer to practise the case just turned off its list, on its own line so it
         is not missed, and outside the rep row so it does not fade with it. A coach drill holds its
         room, so the cube does not jump. -->
    <TextView
       android:id="@+id/tvDrillPracticeOffer"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center_horizontal"
       android:layout_marginTop="8dp"
       android:background="@drawable/drill_practice_offer"
       android:drawablePadding="6dp"
       android:gravity="center_vertical"
       android:paddingLeft="12dp"
       android:paddingRight="16dp"
       android:paddingTop="6dp"
       android:paddingBottom="6dp"
       android:singleLine="true"
       android:fontFamily="@font/roboto_medium"
       android:textColor="@color/on_accent"
       android:textSize="14sp"
       android:text="@string/drill_practice_offer"
       android:visibility="gone"/>

    <!-- The drill so far, on the app's own card: where it has got, the mode it cannot leave, and
         the figures the summary will open on. -->
    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:background="@drawable/analysis_card"
       android:orientation="vertical"
       android:paddingLeft="12dp"
       android:paddingRight="12dp"
       android:paddingTop="10dp"
       android:paddingBottom="13dp">

      <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:gravity="center_vertical"
         android:orientation="horizontal">

        <TextView
           android:id="@+id/tvDrillProgress"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_weight="1"
           android:singleLine="true"
           android:ellipsize="end"
           android:textColor="@color/secondary_text"
           android:textSize="13sp"
           android:fontFeatureSettings="tnum"/>

        <!-- The mode picked before the drill started, shown because it cannot be changed now. -->
        <TextView
           android:id="@+id/tvDrillMode"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:background="@drawable/smart_cube_pill"
           android:backgroundTint="@color/white_wash_10"
           android:paddingLeft="10dp"
           android:paddingRight="10dp"
           android:paddingTop="3dp"
           android:paddingBottom="3dp"
           android:textColor="@color/secondary_text"
           android:textSize="12sp"/>
      </LinearLayout>

      <!-- A coach drill's progress, a bar per case, in place of the rep count's meter. -->
      <com.cube.nanotimer.gui.widget.DrillCasePips
         android:id="@+id/vDrillCasePips"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="10dp"
         android:visibility="gone"/>

      <!-- Not tappable, so it is not a control: a drill has a known end. -->
      <ProgressBar
         android:id="@+id/pbDrillProgress"
         style="?android:attr/progressBarStyleHorizontal"
         android:layout_width="match_parent"
         android:layout_height="4dp"
         android:layout_marginTop="10dp"
         android:progressDrawable="@drawable/drill_progress"/>

      <include
         layout="@layout/drill_live_cells"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- None of the three is a start or stop control: the cube still reports both ends of a rep.
         Quiet pills, so they do not outshout the cube; DrillControlLabels sizes the words. -->
    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:orientation="horizontal">

      <!-- The case's algorithms, for a case that has gone. The rep runs on: stopping its clock for
           this would teach looking it up, so the rep is marked instead. -->
      <Button
         android:id="@+id/btDrillAlgorithm"
         style="@style/DrillGhostButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         android:text="@string/drill_case_algorithm"/>

      <!-- Deals the same case again for a slip, and costs no rep. -->
      <Button
         android:id="@+id/btDrillReset"
         style="@style/DrillGhostButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         android:layout_marginLeft="8dp"
         android:text="@string/drill_reset"/>

      <!-- Skipping spends the rep rather than escaping it: a case you could not do is a result. -->
      <Button
         android:id="@+id/btDrillSkip"
         style="@style/DrillGhostButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         android:layout_marginLeft="8dp"
         android:text="@string/drill_skip"/>
    </LinearLayout>

  </LinearLayout>

  <!-- What the drill leaves behind: the figures for the run, then the case-by-case table that says
       where those figures came from, the warning that the cube is scrambled, and the way out under
       the thumb. On the app's own ground and its own cells, like every other screen that reports
       numbers.

       The way out is outside the scroll: the table is as long as the drill had cases, and a drill
       of all 57 OLLs would otherwise bury Done under fifty-seven rows. -->
  <LinearLayout
     android:id="@+id/drillSummary"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/graybg"
     android:orientation="vertical"
     android:visibility="gone">

  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingLeft="16dp"
       android:paddingRight="16dp"
       android:paddingTop="6dp"
       android:paddingBottom="16dp">

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:text="@string/drill_finished"
         android:textColor="@color/white"
         android:textSize="26sp"
         android:fontFamily="@font/roboto_medium"
         android:textStyle="normal"/>

      <!-- What was drilled and in which mode, since the drill is over and its own bar is gone. -->
      <TextView
         android:id="@+id/tvDrillSummarySubtitle"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="2dp"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"/>

      <!-- The three figures the drill is read from. Shared with the drill stats screen. -->
      <include
         layout="@layout/drill_stat_cells"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="14dp"/>

      <!-- Instead of the cells, for a drill with nothing to average. -->
      <TextView
         android:id="@+id/tvDrillSummaryEmpty"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="20dp"
         android:textColor="@color/white"
         android:textSize="17sp"
         android:visibility="gone"/>

      <!-- A coach drill's ending: what stopped it, and which cases are still over target. -->
      <TextView
         android:id="@+id/tvDrillSummaryNote"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="14dp"
         android:textColor="@color/white"
         android:textSize="14sp"
         android:lineSpacingMultiplier="1.1"
         android:visibility="gone"/>

      <!-- A coach drill's cases against their targets: one line per case, dots as on the drill. -->
      <LinearLayout
         android:id="@+id/llDrillTargets"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="18dp"
         android:orientation="vertical"
         android:visibility="gone">

        <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:paddingBottom="8dp"
           android:orientation="horizontal">

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="0dp"
             android:layout_weight="1.5"
             android:text="@string/drill_targets_column_case"/>

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="0dp"
             android:layout_weight="0.7"
             android:text="@string/drill_targets_column_reps"/>

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="0dp"
             android:layout_weight="1.1"
             android:text="@string/drill_targets_column_wins"/>

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="0dp"
             android:layout_weight="0.9"
             android:gravity="end"
             android:text="@string/drill_targets_column_target"/>

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="0dp"
             android:layout_weight="0.9"
             android:gravity="end"
             android:text="@string/drill_summary_cell_mean"/>
        </LinearLayout>

        <LinearLayout
           android:id="@+id/llDrillTargetRows"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical"/>
      </LinearLayout>

      <!-- Where the figures above came from. One line per case rather than per rep, because the
           question a finished drill answers is which cases the time went to, and a case dealt four
           times is one answer and not four.

           The three headings are the sort: tapping one ranks the table by that column and taps
           again to turn it round, and the ranked column is the one written in white. A control of
           its own above the table would have had to name the same three things a second time. -->
      <LinearLayout
         android:id="@+id/llDrillCasesSection"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"
         android:visibility="gone">

        <include
           layout="@layout/case_table"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="22dp"/>
      </LinearLayout>

    </LinearLayout>
  </ScrollView>

    <!-- The sheet's own action, in the accent the main screen's Start wears: it is the only thing
         to do here, and a tonal slab beside a page of colour read as one more disabled control. -->
    <androidx.appcompat.widget.AppCompatButton
       android:id="@+id/btDrillDone"
       style="@style/HeroStartButton"
       android:layout_marginTop="12dp"
       android:layout_marginLeft="16dp"
       android:layout_marginRight="16dp"
       android:layout_marginBottom="16dp"
       android:text="@string/drill_done"/>

  </LinearLayout>

  <!-- Nothing to drill with. Said in place of the drill rather than over it. -->
  <TextView
     android:id="@+id/tvDrillUnavailable"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/graybg"
     android:gravity="center"
     android:padding="32dp"
     android:textColor="@color/secondary_text"
     android:textSize="16sp"
     android:visibility="gone"/>

</FrameLayout>
