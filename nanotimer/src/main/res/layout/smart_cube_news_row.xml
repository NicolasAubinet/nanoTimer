<?xml version="1.0" encoding="utf-8"?>
<!-- One thing the news sheet announces: its icon on a tile, a bold line, and one sentence. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:layout_marginTop="14dp"
   android:orientation="horizontal">

  <FrameLayout
     android:layout_width="38dp"
     android:layout_height="38dp"
     android:layout_marginEnd="14dp"
     android:layout_marginRight="14dp"
     android:background="@drawable/coach_hero_icon_tile">
    <ImageView
       android:id="@+id/imgNewsRow"
       android:layout_width="22dp"
       android:layout_height="22dp"
       android:layout_gravity="center"
       android:tint="@color/lightblue"
       android:contentDescription="@null"/>
  </FrameLayout>

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical">
    <TextView
       android:id="@+id/tvNewsRowTitle"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:textColor="@color/white"
       android:textSize="15sp"
       android:textStyle="bold"/>
    <TextView
       android:id="@+id/tvNewsRowBody"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="2dp"
       android:textColor="@color/secondary_text"
       android:textSize="13sp"/>
  </LinearLayout>
</LinearLayout>
